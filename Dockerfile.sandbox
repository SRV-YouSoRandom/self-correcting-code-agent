FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN uv pip install --system --no-cache \
    requests \
    beautifulsoup4 \
    pandas \
    matplotlib \
    numpy \
    lxml

RUN useradd -m -u 1000 sandbox

WORKDIR /workspace
RUN chown sandbox:sandbox /workspace

USER sandbox
